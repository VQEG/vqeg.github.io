---
import VqegLayout from '~/layouts/VqegLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;

const vision = [
  {
    title: 'Collaborate',
    image: '/media/p0cliijw/collaborate.png',
    items: [
      'Leverage resources from multiple organizations',
      'Combine individual research efforts into general solutions',
    ],
  },
  {
    title: 'Connect',
    image: '/media/xauonbcj/connect-img.jpg',
    items: ['Convey industry needs to academic researchers', 'Promote communication among researchers'],
  },
  {
    title: 'Achieve',
    image: '/media/n0wphzxp/achieve-image.jpg',
    items: [
      'Develop new and improved methods',
      'Prove method validity',
      "Analyze cutting-edge technologies' impact on perceived quality",
      'Drive new and improved international standards',
    ],
  },
];
---

<VqegLayout title="VQEG — Video Quality Experts Group">
  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-2 md:items-center md:py-20">
    <div>
      <p class="mb-4 font-semibold uppercase tracking-[0.18em] text-vqeg-red">Video Quality Experts Group</p>
      <h1 class="max-w-xl text-4xl font-bold leading-tight text-vqeg-blue md:text-5xl">
        VQEG brings international experts together
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-8 text-slate-700">
        VQEG provides a forum, via email lists and face-to-face meetings, for video quality assessment experts to
        exchange information and work together on common goals.
      </p>
      <a
        href={withBase('/projects')}
        class="mt-7 inline-block rounded bg-vqeg-blue-dark px-5 py-3 font-semibold text-white transition hover:bg-vqeg-blue"
        >Explore VQEG projects</a
      >
    </div>
    <img
      src={withBase('/media/f1tnuugd/home-tripic.jpg')}
      alt="VQEG members collaborating"
      class="w-full rounded-sm shadow-lg"
    />
  </section>

  <section
    class="vqeg-work-cta bg-slate-100 py-14"
    style={`--connections-image: url('${withBase('/assets/CONNECTIONS.svg')}')`}
  >
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="vqeg-section-title">Who we work with</h2>
      <ul class="vqeg-work-list mt-5 text-lg font-semibold text-vqeg-blue">
        <li>Industry</li><li>Academia</li><li>Government organizations</li><li>
          International Telecommunication Union (ITU)
        </li><li>Other standards-developing organizations</li>
      </ul>
    </div>
  </section>

  <section class="vqeg-home-meeting bg-vqeg-red py-12 text-white">
    <div
      class="relative mx-auto grid max-w-6xl gap-8 px-5 md:grid-cols-[9rem_minmax(0,0.7fr)_minmax(0,1.3fr)] md:items-center"
    >
      <div class="hidden justify-center md:flex">
        <img src={withBase('/media/ssanpki5/screen-icon.svg')} alt="Screen" class="w-28" />
      </div>
      <div>
        <h2 class="text-2xl font-bold">Meeting venues</h2>
        <p class="mt-3">Meetings shift from country to country.</p>
        <ul class="mt-4 space-y-2 text-sm font-semibold">
          <li><a href={withBase('/email-reflectors')} class="underline">Email reflectors</a></li>
          <li><a href={withBase('/meetings')} class="underline">Open meetings</a></li>
          <li>
            <a href="https://www.linkedin.com/company/vqeg-video-quality-experts-group/" class="underline"
              >VQEG on LinkedIn</a
            >
          </li>
        </ul>
      </div>
      <div class="border-t border-white/40 pt-6 md:border-t-0 md:border-l md:pl-8 md:pt-0">
        <h2 class="text-2xl font-bold">Upcoming conference calls</h2>
        <ul class="mt-4 space-y-3 text-sm font-semibold">
          <li>14–18 December 2026, VQEG online meeting</li>
          <li>24–27 May 2027, VQEG in-person meeting in New York, USA, hosted by AT&amp;T</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="vqeg-section-title">VQEG vision</h2>
    <div class="mt-8 grid gap-7 md:grid-cols-3">
      {
        vision.map((item) => (
          <article class="overflow-hidden rounded-sm border border-slate-200 bg-white shadow-sm">
            <>
              <img src={withBase(item.image)} alt="" class="h-44 w-full object-cover" />
              <div class="p-6">
                <>
                  <h3 class="text-xl font-bold uppercase text-vqeg-blue">{item.title}</h3>
                  <ul class="mt-4 list-disc space-y-2 pl-5 text-slate-700">
                    {item.items.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-8">
    <h2 class="vqeg-section-title">VQEG mission</h2>
    <div class="space-y-5 text-lg leading-8 text-slate-700">
      <p>
        The Video Quality Experts Group was first grounded in subjective methodology and objective tool development and
        verification for video quality assessment, helping move the industry forward through standardization and
        implementation.
      </p><p>
        As multimedia has become pervasive across devices and distribution paths have expanded from broadcast to
        cellular networks, VQEG’s work has expanded from visual quality to Quality of Experience (QoE).
      </p><p>
        VQEG advances methods and tools for new technologies by bringing qualitative and quantitative approaches
        together, enabling unprecedented collaboration and execution.
      </p>
    </div>
  </section>
</VqegLayout>

<style>
  .text-vqeg-red {
    color: #d63e04;
  }
  .vqeg-section-title {
    display: inline-block;
    border-bottom: 3px solid #d63e04;
    padding-bottom: 0.5rem;
    color: #003366;
    font-size: 1.5rem;
    font-weight: 700;
  }
  .vqeg-work-cta {
    background-image: var(--connections-image);
    background-position: top right -12.5rem;
    background-repeat: no-repeat;
    background-size: auto 110%;
  }
  .vqeg-work-list {
    list-style: none;
  }
  .vqeg-work-list li {
    position: relative;
    margin: 0.55rem 0;
    padding-left: 1.25rem;
  }
  .vqeg-work-list li::before {
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 0.55rem;
    height: 0.55rem;
    background: #d63e04;
    content: '';
  }
  .vqeg-home-meeting {
    position: relative;
    overflow: hidden;
  }
  .vqeg-home-meeting::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: max(20%, calc((100vw - 72rem) / 2 + 10rem));
    background: rgb(255 255 255 / 0.12);
    clip-path: polygon(0 0, 88% 0, 100% 50%, 88% 100%, 0 100%);
    content: '';
  }
  .vqeg-home-meeting a {
    color: white;
  }
  .vqeg-home-meeting a:hover {
    color: rgb(255 255 255 / 0.8);
  }
  @media (max-width: 768px) {
    .vqeg-work-cta {
      background-image: none;
    }
    .vqeg-home-meeting::before {
      display: none;
    }
  }
</style>
