---
import VqegLayout from '~/layouts/VqegLayout.astro';

const home = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<VqegLayout title="Page not found">
  <section class="mx-auto max-w-3xl px-5 py-24 text-center">
    <p class="text-lg font-semibold text-vqeg-red">Error 404</p>
    <h1 class="mt-3 text-4xl font-bold text-vqeg-blue">This page could not be found.</h1>
    <p class="mt-5 text-lg text-slate-700">Try the VQEG home page or explore the current projects.</p>
    <p class="mt-8">
      <a href={home} class="rounded bg-vqeg-blue-dark px-5 py-3 font-semibold text-white">
        Back to VQEG home
      </a>
    </p>
  </section>
</VqegLayout>
