---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;

const links = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects' },
  { label: 'Project Chairs', href: '/board' },
  { label: 'Meetings', href: '/meetings' },
  { label: 'Email Reflectors', href: '/email-reflectors' },
  { label: 'Publications & Software', href: '/publications-and-software' },
  { label: 'Resources', href: '/video-datasets-and-organizations' },
  { label: 'About VQEG', href: '/about' },
];

const pathname = Astro.url.pathname.slice(base.length - 1).replace(/\/$/, '') || '/';
---

<header class="border-b border-vqeg-blue-dark bg-vqeg-blue text-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-4">
    <a href={withBase('/')} class="flex shrink-0 items-center gap-4" aria-label="VQEG home">
      <img src={withBase('/assets/VQEG-logo.svg')} alt="VQEG" class="h-12 w-auto" />
      <span class="hidden border-l border-white/30 pl-4 text-sm font-semibold text-white sm:block">
        Video Quality Experts Group
      </span>
    </a>
    <details class="relative lg:hidden">
      <summary class="cursor-pointer rounded border border-white/70 px-3 py-2 text-sm font-semibold text-white">
        Menu
      </summary>
      <nav
        class="absolute right-0 z-20 mt-2 w-72 rounded bg-white p-3 text-slate-800 shadow-xl"
        aria-label="Main navigation"
      >
        <ul class="space-y-1">
          {links.map((link) => (
            <li>
              <a class="block rounded px-3 py-2 hover:bg-slate-100" href={withBase(link.href)}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
  <nav class="hidden border-t border-white/30 bg-vqeg-blue-dark lg:block" aria-label="Main navigation">
    <ul class="mx-auto flex max-w-6xl items-stretch px-5">
      {links.map((link) => (
        <li>
          <a
            class:list={[
              'block px-3 py-3 text-sm font-semibold text-white transition hover:bg-white/15',
              { 'bg-vqeg-red': pathname === link.href },
            ]}
            href={withBase(link.href)}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
